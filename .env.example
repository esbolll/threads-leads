# Copy to .env. Never commit .env.

# Storage
DB_PATH=data/leads.db
OUTPUT_DIR=output
LOG_LEVEL=info
# Skip leads whose post is older than N days (0 = keep all). New leads are always ordered newest first.
LEAD_MAX_AGE_DAYS=0
# true = only posts from the current calendar month are shown/sent. Batches go oldest -> newest.
LEAD_CURRENT_MONTH_ONLY=false

# Threads API. Token is written by `threads-leads auth`; app id/secret from the Threads use case Settings page.
THREADS_TOKEN=
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://localhost:8443/callback
THREADS_SEARCH_LIMIT=50

# Browser source (Google Chrome with a persistent profile)
THREADS_CHROME=
BROWSER_PROFILE_DIR=threads_profile
BROWSER_HEADLESS=false
BROWSER_SCROLLS=4

# Telegram notifications (optional). Bot must be admin of the channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
