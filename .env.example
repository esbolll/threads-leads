# Threads API user access token (threads_basic + threads_keyword_search).
# Get it from Meta App Dashboard -> Threads use case -> User Token Generator.
THREADS_TOKEN=

# Needed only for `threads-leads.exe -auth` (OAuth flow). From the Threads use case Settings page.
THREADS_APP_ID=
THREADS_APP_SECRET=

# Telegram notifications (optional). Bot must be admin of the channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
